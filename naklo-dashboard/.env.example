# Postgres (doporučeno: samostatný projekt v EU, ne databáze webu)
DATABASE_URL=postgres://hr:hr@localhost:5432/wsn_hr

# Auth.js – Google přihlášení
AUTH_SECRET=vygeneruj-pres-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Kdo se smí přihlásit (čárkou oddělené). Doména je navíc omezená na wakesurfnaklo.cz.
ALLOWED_EMAILS=radko@wakesurfnaklo.cz,info@wakesurfnaklo.cz
ALLOWED_DOMAIN=wakesurfnaklo.cz

# Jen pro lokální vývoj, v produkci se ignoruje
AUTH_DISABLED=0

# KiloMayo (synchronizace jen pro čtení)
KILOMAYO_BASE_URL=https://naklo.kilomayo.app
KILOMAYO_LOGIN_EMAIL=info@wakesurfnaklo.cz

# Google Sheets (Events) – servisní účet jen pro čtení, tabulku mu nasdílej jako Čtenář
GOOGLE_SERVICE_ACCOUNT_JSON=
EVENTS_SHEET_ID=
