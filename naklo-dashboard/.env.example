# Postgres (doporučeno: samostatný projekt v EU, ne databáze webu)
DATABASE_URL=postgres://hr:hr@localhost:5432/wsn_hr

# Auth.js – Google přihlášení
AUTH_SECRET=vygeneruj-pres-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Kdo se smí přihlásit (čárkou oddělené). Doména je navíc omezená na wakesurfnaklo.cz.
ALLOWED_EMAILS=radko@wakesurfnaklo.cz,info@wakesurfnaklo.cz
ALLOWED_DOMAIN=wakesurfnaklo.cz

# Jen pro lokální vývoj, v produkci se ignoruje
AUTH_DISABLED=0

# KiloMayo (synchronizace jen pro čtení)
KILOMAYO_BASE_URL=https://naklo.kilomayo.app
KILOMAYO_LOGIN_EMAIL=info@wakesurfnaklo.cz
KILOMAYO_PASSWORD=

# Google Sheets (Events) – servisní účet jen pro čtení, tabulku mu nasdílej jako Čtenář
GOOGLE_SERVICE_ACCOUNT_JSON=
EVENTS_SHEET_ID=

# Centrální bot
CRON_SECRET=
GEMINI_API_KEY=
DASHBOARD_URL=https://dashboard.wakesurfnaklo.cz

# Banka: KB API, Account Direct Access (jen čtení). Postup v README, sekce Banka.
# Klíč pro šifrování tajemství banky v DB: openssl rand -base64 32
BANK_ENCRYPTION_KEY=
# API klíče z https://developers.kb.cz (každá služba má vlastní)
KB_API_KEY_OAUTH=
KB_API_KEY_ADAA=
# Výstup npm run kb:statement (JWT, platí 12 měsíců)
KB_SOFTWARE_STATEMENT=
KB_REDIRECT_URI=https://dashboard.wakesurfnaklo.cz/api/bank/kb/callback
# Sandbox: KB_API_BASE=https://api-gateway.kb.cz/sandbox
KB_API_BASE=https://api-gateway.kb.cz
