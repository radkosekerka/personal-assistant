# Nastavení nasazení Náklo Dashboardu na Google Cloud. Nic tajného sem nepatří (tajemství jsou v Secret Manageru).
PROJECT_ID=naklo-dashboard            # ID GCP projektu, který Radko založí
REGION=europe-west1                   # Belgie: EU, podporuje i mapování vlastní domény
SERVICE=naklo-dashboard               # Cloud Run služba (web)
REPO=naklo                            # Artifact Registry repozitář s obrazy
SQL_INSTANCE=naklo-db                 # Cloud SQL instance (PostgreSQL 16)
SQL_TIER=db-f1-micro                  # nejmenší sdílené CPU, pro pár uživatelů stačí
DB_NAME=naklo
DB_USER=naklo
RUN_SA=naklo-dashboard-run            # servisní účet, pod kterým běží web i úlohy
SCHEDULER_SA=naklo-dashboard-scheduler

# Kdo se dostane přes IAP (první zámek). Druhý zámek je ALLOWED_EMAILS v aplikaci.
IAP_MEMBERS="domain:wakesurfnaklo.cz"
ALLOWED_DOMAIN=wakesurfnaklo.cz
ALLOWED_EMAILS=radko@wakesurfnaklo.cz,info@wakesurfnaklo.cz

# Veřejná adresa. Po prvním nasazení sem dej URL z výstupu (https://naklo-dashboard-….europe-west1.run.app),
# později případně https://dashboard.wakesurfnaklo.cz.
DASHBOARD_URL=
KB_API_BASE=https://api-gateway.kb.cz
KILOMAYO_BASE_URL=https://naklo.kilomayo.app
KILOMAYO_LOGIN_EMAIL=info@wakesurfnaklo.cz
EVENTS_SHEET_ID=

# Plán úloh (Europe/Prague)
TZ_SCHEDULE=Europe/Prague
CRON_BANK="30 5 * * *"
CRON_BOT="0 6 * * *"
CRON_EVENTS="15 * * * *"
CRON_KILOMAYO="45 5 * * *"
